# Canonical site URL (required for sitemap, Open Graph, and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://albinanthony.tech

# EmailJS (https://www.emailjs.com/) — add the same vars in Cloudflare Pages/Workers
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key
